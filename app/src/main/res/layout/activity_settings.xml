<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B1622" android:padding="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="CLAUDE API KEY" android:textColor="#00C48C"
            android:textSize="11sp" android:textStyle="bold"
            android:layout_marginBottom="6dp" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Free at console.anthropic.com"
            android:textColor="#607080" android:textSize="12sp" android:layout_marginBottom="12dp"/>
        <EditText android:id="@+id/et_api_key" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="sk-ant-api03-..."
            android:inputType="textPassword" android:textColor="#FFFFFF"
            android:textColorHint="#607080" android:background="#131F2E"
            android:padding="14dp" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btn_save" android:layout_width="match_parent"
            android:layout_height="52dp" android:text="Save API Key"
            android:textColor="#FFFFFF" android:background="#00C48C"
            android:layout_marginBottom="32dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="MAX AGE RATING ALLOWED" android:textColor="#00C48C"
            android:textSize="11sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Videos rated above this will be blocked"
            android:textColor="#607080" android:textSize="12sp" android:layout_marginBottom="16dp"/>
        <RadioGroup android:id="@+id/rg_age_rating" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginBottom="32dp">
            <RadioButton android:id="@+id/rb_all_ages" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="All Ages only (strictest)"
                android:textColor="#FFFFFF" android:textSize="14sp" android:padding="8dp"
                android:buttonTint="#00C48C" android:background="#131F2E"
                android:layout_marginBottom="8dp"/>
            <RadioButton android:id="@+id/rb_six_plus" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="Up to 6+  (recommended)"
                android:textColor="#FFFFFF" android:textSize="14sp" android:padding="8dp"
                android:buttonTint="#00C48C" android:background="#131F2E"
                android:layout_marginBottom="8dp" android:checked="true"/>
            <RadioButton android:id="@+id/rb_eight_plus" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="Up to 8+  (older kids)"
                android:textColor="#FFFFFF" android:textSize="14sp" android:padding="8dp"
                android:buttonTint="#00C48C" android:background="#131F2E"
                android:layout_marginBottom="8dp"/>
            <RadioButton android:id="@+id/rb_thirteen_plus" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="Up to 13+  (teens)"
                android:textColor="#FFFFFF" android:textSize="14sp" android:padding="8dp"
                android:buttonTint="#00C48C" android:background="#131F2E"
                android:layout_marginBottom="8dp"/>
        </RadioGroup>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="DATA" android:textColor="#00C48C" android:textSize="11sp"
            android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <Button android:id="@+id/btn_clear" android:layout_width="match_parent"
            android:layout_height="52dp" android:text="Clear History + Approved List"
            android:textColor="#FFFFFF" android:background="#FF3D57"
            android:layout_marginBottom="32dp"/>
    </LinearLayout>
</ScrollView>
