<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1622"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SafeStream AI"
        android:textColor="#00C48C"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Protecting kids on YouTube"
        android:textColor="#607080"
        android:textSize="14sp"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Monitoring: INACTIVE"
        android:textColor="#FF3D57"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btn_enable"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Enable Monitoring"
        android:textColor="#FFFFFF"
        android:background="#00C48C"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_settings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Settings"
        android:textColor="#FFFFFF"
        android:background="#131F2E"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_block_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Videos blocked: 0"
        android:textColor="#607080"
        android:textSize="13sp"
        android:layout_marginTop="24dp"/>

</LinearLayout>
