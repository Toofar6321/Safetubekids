<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#EE0B1622">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SafeTube Kids"
        android:textColor="#00C48C"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Video Blocked"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/ov_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#CCDDEE"
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/ov_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF6B7A"
        android:textSize="12sp"
        android:textAlignment="center"
        android:layout_marginBottom="36dp"/>

    <Button
        android:id="@+id/ov_btn_suggest"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Try a safe video instead"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:background="#00A87A"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/ov_btn_ok"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Got It"
        android:textColor="#0B1622"
        android:textSize="14sp"
        android:background="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/ov_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Closing in 8s"
        android:textColor="#607080"
        android:textSize="12sp"/>

</LinearLayout>
