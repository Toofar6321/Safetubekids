<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#EE0B1622">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="&#128737;"
        android:textSize="64sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Video Blocked"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/ov_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textAlignment="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/ov_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF3D57"
        android:textSize="13sp"
        android:textAlignment="center"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/ov_btn_ok"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Got It"
        android:textColor="#0B1622"
        android:background="#00C48C"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/ov_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auto-closing in 6s"
        android:textColor="#607080"
        android:textSize="12sp"/>

</LinearLayout>
